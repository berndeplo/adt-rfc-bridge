# JCo libraries directory. `npm run setup` populates ./jco-libs by copying the
# SAP JCo jars out of your local Eclipse ADT install. Leave this as-is unless
# your JCo libraries live elsewhere.
JCO_LIBS_DIR=./jco-libs

# Bridge HTTP port (this is what arc-1's SAP_URL points to).
BRIDGE_PORT=18080

# SAP connection. Use either (SAP_ASHOST + SAP_SYSNR) for direct app server,
# OR (SAP_MSHOST + SAP_MSSERV + SAP_R3NAME + SAP_GROUP) for message-server / load-balanced.

# --- Option A: direct application server ---
# SAP_ASHOST=your-app-server.example.com
# SAP_SYSNR=00

# --- Option B: message server / load-balanced (shown here) ---
SAP_MSHOST=your-message-server.example.com
SAP_MSSERV=3601
SAP_R3NAME=SID
SAP_GROUP=PUBLIC

SAP_CLIENT=100
SAP_USER=YOURUSER
# Always quote the password. Node's env-file parser treats an unquoted `#` as the
# start of a comment and silently truncates the value; SAP then answers "Name or
# password is incorrect (repeat logon)", which looks nothing like a parsing bug.
SAP_PASSWORD="put-password-here"
SAP_LANGUAGE=EN

# Optional: java binary (defaults to "java" on PATH)
# JAVA=/opt/homebrew/opt/openjdk/bin/java
